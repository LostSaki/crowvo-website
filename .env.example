# -----------------------------------------------------------------------------

# Postgres — Supabase (same database as production on Cloudflare / crow-vo.com)

#

# Run once:  npm run setup:db

# That writes .env.local with DATABASE_URL + DIRECT_URL from Supabase.

#

# Manual (Dashboard → Connect → Prisma → Transaction mode):

# DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres"



# Analytics

NEXT_PUBLIC_GA_MEASUREMENT_ID=""

NEXT_PUBLIC_POSTHOG_KEY=""

NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"

NEXT_PUBLIC_HOTJAR_ID=""



# Upstash Redis (distributed rate limiting on Cloudflare)

UPSTASH_REDIS_REST_URL=""

UPSTASH_REDIS_REST_TOKEN=""



# Inbox for contact + investor form submissions (Resend delivers here; must be verified in Resend test mode)
CONTACT_INBOX_EMAIL="dylan.aruizmoya@gmail.com"
NEXT_PUBLIC_CONTACT_EMAIL="dylsn@gmail.com"

# Optional: waitlist admin notifications (defaults to CONTACT_INBOX_EMAIL if unset)
# ADMIN_NOTIFY_EMAIL="dylan.aruizmoya@gmail.com"

ADMIN_USERNAME="admin"

ADMIN_PASSWORD="replace-with-a-strong-password"



# Production marketing site (Cloudflare Workers)

NEXT_PUBLIC_SITE_URL="https://crow-vo.com"



# Crowvo platform app — use localhost in .env.local for dev; production uses app.crow-vo.com
NEXT_PUBLIC_CROWVO_APP_URL="https://app.crow-vo.com"



# Platform API — admin access codes proxy (local dev; set on Cloudflare when API is public)

CROWVO_API_URL="http://localhost:4000/v1"

CROWVO_ADMIN_API_KEY="replace-with-strong-admin-key"

# Windows desktop download page (leave download URL empty until the first installer is published)
NEXT_PUBLIC_DESKTOP_VERSION="0.1.0"
NEXT_PUBLIC_DESKTOP_RELEASED_AT=""
NEXT_PUBLIC_DESKTOP_SIZE=""
NEXT_PUBLIC_DESKTOP_SHA256=""
NEXT_PUBLIC_DESKTOP_DOWNLOAD_URL=""
