{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/page,_N_T_/,_N_T_/index"},"segmentPaths":["/_tree","/_full","/__PAGE__","/_index","/_head"]},"html":"<!DOCTYPE html><html lang=\"en\" class=\"__variable_246ccd __variable_4c40f6 h-full antialiased\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"stylesheet\" href=\"/_next/static/css/929cc579c236f361.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/webpack-6bbc21fc53639a8a.js\"/><script src=\"/_next/static/chunks/4bd1b696-215e5051988c3dde.js\" async=\"\"></script><script src=\"/_next/static/chunks/794-2e9f20eba326fbe9.js\" async=\"\"></script><script src=\"/_next/static/chunks/main-app-a00441ad7ebde43a.js\" async=\"\"></script><script src=\"/_next/static/chunks/9da6db1e-a9775a91962987a2.js\" async=\"\"></script><script src=\"/_next/static/chunks/500-c99b8dfd3de17c86.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/layout-0f5bf06c44d3fdf0.js\" async=\"\"></script><script src=\"/_next/static/chunks/398-1ebaea207cdb9881.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/page-131c98d829b01e21.js\" async=\"\"></script><title>Crowvo | Communities first. People first. Privacy first.</title><meta name=\"description\" content=\"Crowvo is built for communities — not advertisers. Talk, organize, and grow together without algorithms, data selling, or endless noise.\"/><link rel=\"icon\" href=\"/favicon.ico?603d046c9a6fdfbb\" type=\"image/x-icon\" sizes=\"16x16\"/><script src=\"/_next/static/chunks/polyfills-42372ed130431b0a.js\" noModule=\"\"></script></head><body class=\"crowvo-mesh flex min-h-full flex-col\"><div hidden=\"\"><!--$--><!--/$--></div><header class=\"sticky top-0 z-50 border-b border-border bg-background/85 backdrop-blur-xl\"><div class=\"mx-auto flex max-w-6xl items-center justify-between px-4 py-3 sm:px-6\"><a class=\"flex items-center gap-2.5 text-lg font-bold tracking-tight text-foreground\" href=\"/\"><div class=\"flex items-center justify-center rounded-2xl bg-accent font-bold text-white shadow-lg shadow-accent/30 h-10 w-10 text-base\">C</div>Crowvo</a><nav class=\"hidden gap-5 text-sm text-muted lg:flex\"><a class=\"transition hover:text-foreground\" href=\"/\">Home</a><a class=\"transition hover:text-foreground\" href=\"/features\">Features</a><a class=\"transition hover:text-foreground\" href=\"/communities\">Communities</a><a class=\"transition hover:text-foreground\" href=\"/safety\">Safety</a><a class=\"transition hover:text-foreground\" href=\"/about\">About</a><a class=\"transition hover:text-foreground\" href=\"/faq\">FAQ</a><a class=\"transition hover:text-foreground\" href=\"/contact\">Contact</a></nav><div class=\"flex items-center gap-2\"><a href=\"http://localhost:3001/join\" class=\"btn-secondary hidden sm:inline-flex\">Get invite</a><a href=\"http://localhost:3001\" target=\"_blank\" rel=\"noopener noreferrer\" data-analytics-event=\"cta_start_hub_click\" data-analytics-cta=\"navbar_launch_app\" class=\"btn-primary\">Open app</a></div></div></header><main class=\"flex-1\"><div class=\"mx-auto flex w-full max-w-6xl flex-col gap-14 px-4 py-12 sm:px-6\"><section style=\"opacity:0;transform:translateY(24px)\"><div class=\"grid items-start gap-10 lg:grid-cols-[1.05fr_0.95fr]\"><div class=\"space-y-6\"><p class=\"inline-flex rounded-full border border-accent/30 bg-accent/10 px-3 py-1 text-xs font-semibold tracking-[0.14em] text-accent\">Community first · People first · Privacy first</p><h1 class=\"text-4xl font-bold leading-tight tracking-tight sm:text-5xl lg:text-6xl\">Social media was built for advertisers.<br/><span class=\"text-accent\">Crowvo is built for communities.</span></h1><p class=\"max-w-2xl text-base leading-relaxed text-muted sm:text-lg\">A calm place where communities can talk, organize, share, and grow — without algorithms pushing rage bait, without selling your data, and without endless noise.</p><div class=\"flex flex-wrap gap-3\"><a href=\"http://localhost:3001/join\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"btn-primary\">Get an invite</a><a class=\"btn-secondary\" href=\"/about\">Why Crowvo exists</a></div><div class=\"grid gap-2 sm:grid-cols-2\"><p class=\"rounded-lg border border-border bg-glass px-3 py-2 text-xs text-muted\">Real communities</p><p class=\"rounded-lg border border-border bg-glass px-3 py-2 text-xs text-muted\">Private by default</p><p class=\"rounded-lg border border-border bg-glass px-3 py-2 text-xs text-muted\">Real-time chat</p><p class=\"rounded-lg border border-border bg-glass px-3 py-2 text-xs text-muted\">Community feeds</p><p class=\"rounded-lg border border-border bg-glass px-3 py-2 text-xs text-muted\">Events</p><p class=\"rounded-lg border border-border bg-glass px-3 py-2 text-xs text-muted\">Roles and groups</p><p class=\"rounded-lg border border-border bg-glass px-3 py-2 text-xs text-muted\">Secure accounts</p><p class=\"rounded-lg border border-border bg-glass px-3 py-2 text-xs text-muted\">Community governance</p></div></div><div class=\"space-y-4\"><div class=\"glass-panel rounded-2xl p-5 glow-ring \"><p class=\"text-xs font-semibold uppercase tracking-widest text-cyan\">Community feed</p><div class=\"mt-3 space-y-3\"><div class=\"rounded-xl border border-border bg-surface-elevated/80 p-3\"><p class=\"text-sm font-semibold text-foreground\">Study Group · Tuesday</p><p class=\"mt-1 text-xs leading-relaxed text-muted\">Anyone free to review chapter 4 together tonight?</p></div><div class=\"rounded-xl border border-border bg-surface-elevated/80 p-3\"><p class=\"text-sm font-semibold text-foreground\">Neighborhood Block</p><p class=\"mt-1 text-xs leading-relaxed text-muted\">Potluck this Saturday — bring a dish if you can.</p></div></div></div><div class=\"glass-panel rounded-2xl p-5  bg-gradient-to-br from-accent/15 via-surface to-cyan/10\"><p class=\"text-xs font-semibold uppercase tracking-widest text-cyan\">Your community · private channels</p><div class=\"mt-3 space-y-2 text-sm text-muted\"><p><span class=\"text-cyan\">#</span> general</p><p><span class=\"text-cyan\">#</span> plans</p><p><span class=\"text-cyan\">#</span> help</p></div></div></div></div></section><section style=\"opacity:0;transform:translateY(24px)\"><div class=\"glass-panel rounded-2xl p-5  \"><h2 class=\"text-2xl font-semibold\">Built for people, not engagement metrics.</h2><p class=\"mt-3 max-w-3xl text-sm leading-relaxed text-muted\">Most platforms optimize for time on screen, ad impressions, and outrage. Crowvo optimizes for trust, meaningful conversation, and communities that actually want to be together.</p></div></section><section style=\"opacity:0;transform:translateY(24px)\"><div class=\"grid gap-4 md:grid-cols-3\"><div class=\"glass-panel rounded-2xl p-5  \"><h3 class=\"font-semibold\">Talk without the noise</h3><p class=\"mt-2 text-sm leading-relaxed text-muted\">Feeds and channels designed for your group — not for an algorithm to keep you scrolling.</p></div><div class=\"glass-panel rounded-2xl p-5  \"><h3 class=\"font-semibold\">Organize together</h3><p class=\"mt-2 text-sm leading-relaxed text-muted\">Plan events, share updates, and coordinate in one place your community controls.</p></div><div class=\"glass-panel rounded-2xl p-5  \"><h3 class=\"font-semibold\">Stay in control</h3><p class=\"mt-2 text-sm leading-relaxed text-muted\">Private by default. Your community sets the rules. You decide who belongs.</p></div></div></section><section style=\"opacity:0;transform:translateY(24px)\"><div class=\"glass-panel rounded-2xl p-5  border-accent/25 bg-accent/5 text-center\"><h2 class=\"text-2xl font-semibold\">Build communities people actually want to be part of.</h2><p class=\"mx-auto mt-2 max-w-2xl text-muted\">Crowvo is in invite-only demo. Request access, join a community, and see what social can feel like when people come first.</p><div class=\"mt-5 flex flex-wrap items-center justify-center gap-3\"><a href=\"http://localhost:3001/join\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"btn-primary\">Get an invite</a><a class=\"btn-secondary\" href=\"/communities\">See who it&#x27;s for</a></div></div></section></div><!--$--><!--/$--></main><footer class=\"border-t border-border bg-surface/80 backdrop-blur-xl\"><div class=\"mx-auto flex max-w-6xl flex-col gap-4 px-4 py-8 text-sm text-muted sm:px-6 md:flex-row md:items-center md:justify-between\"><p>© <!-- -->2026<!-- --> Crowvo — built for communities, not advertisers.</p><div class=\"flex flex-wrap gap-4 text-xs\"><a class=\"hover:text-foreground\" href=\"/safety\">Safety</a><a class=\"hover:text-foreground\" href=\"/faq\">FAQ</a><a class=\"hover:text-foreground\" href=\"/waitlist\">Request access</a></div></div></footer><script src=\"/_next/static/chunks/webpack-6bbc21fc53639a8a.js\" id=\"_R_\" async=\"\"></script><script>(self.__next_f=self.__next_f||[]).push([0])</script><script>self.__next_f.push([1,\"1:\\\"$Sreact.fragment\\\"\\n2:I[474,[\\\"229\\\",\\\"static/chunks/9da6db1e-a9775a91962987a2.js\\\",\\\"500\\\",\\\"static/chunks/500-c99b8dfd3de17c86.js\\\",\\\"177\\\",\\\"static/chunks/app/layout-0f5bf06c44d3fdf0.js\\\"],\\\"AnalyticsProvider\\\"]\\n3:I[8500,[\\\"500\\\",\\\"static/chunks/500-c99b8dfd3de17c86.js\\\",\\\"398\\\",\\\"static/chunks/398-1ebaea207cdb9881.js\\\",\\\"974\\\",\\\"static/chunks/app/page-131c98d829b01e21.js\\\"],\\\"\\\"]\\n4:I[7121,[],\\\"\\\"]\\n5:I[4581,[],\\\"\\\"]\\n9:I[7123,[],\\\"default\\\",1]\\n:HL[\\\"/_next/static/css/929cc579c236f361.css\\\",\\\"style\\\"]\\n\"])</script><script>self.__next_f.push([1,\"0:{\\\"P\\\":null,\\\"c\\\":[\\\"\\\",\\\"\\\"],\\\"q\\\":\\\"\\\",\\\"i\\\":false,\\\"f\\\":[[[\\\"\\\",{\\\"children\\\":[\\\"__PAGE__\\\",{}]},\\\"$undefined\\\",\\\"$undefined\\\",16],[[\\\"$\\\",\\\"$1\\\",\\\"c\\\",{\\\"children\\\":[[[\\\"$\\\",\\\"link\