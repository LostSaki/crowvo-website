{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/safety/layout,_N_T_/safety/page,_N_T_/safety"},"segmentPaths":["/_tree","/_full","/safety/__PAGE__","/safety","/_index","/_head"]},"html":"<!DOCTYPE html><html lang=\"en\" class=\"__variable_246ccd __variable_4c40f6 h-full antialiased\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"stylesheet\" href=\"/_next/static/css/929cc579c236f361.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/webpack-6bbc21fc53639a8a.js\"/><script src=\"/_next/static/chunks/4bd1b696-215e5051988c3dde.js\" async=\"\"></script><script src=\"/_next/static/chunks/794-2e9f20eba326fbe9.js\" async=\"\"></script><script src=\"/_next/static/chunks/main-app-a00441ad7ebde43a.js\" async=\"\"></script><script src=\"/_next/static/chunks/9da6db1e-a9775a91962987a2.js\" async=\"\"></script><script src=\"/_next/static/chunks/500-c99b8dfd3de17c86.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/layout-0f5bf06c44d3fdf0.js\" async=\"\"></script><script src=\"/_next/static/chunks/398-1ebaea207cdb9881.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/safety/page-131c98d829b01e21.js\" async=\"\"></script><title>Crowvo | Communities first. People first. Privacy first.</title><meta name=\"description\" content=\"Crowvo is built for communities — not advertisers. Talk, organize, and grow together without algorithms, data selling, or endless noise.\"/><link rel=\"icon\" href=\"/favicon.ico?603d046c9a6fdfbb\" type=\"image/x-icon\" sizes=\"16x16\"/><script src=\"/_next/static/chunks/polyfills-42372ed130431b0a.js\" noModule=\"\"></script></head><body class=\"crowvo-mesh flex min-h-full flex-col\"><div hidden=\"\"><!--$--><!--/$--></div><header class=\"sticky top-0 z-50 border-b border-border bg-background/85 backdrop-blur-xl\"><div class=\"mx-auto flex max-w-6xl items-center justify-between px-4 py-3 sm:px-6\"><a class=\"flex items-center gap-2.5 text-lg font-bold tracking-tight text-foreground\" href=\"/\"><div class=\"flex items-center justify-center rounded-2xl bg-accent font-bold text-white shadow-lg shadow-accent/30 h-10 w-10 text-base\">C</div>Crowvo</a><nav class=\"hidden gap-5 text-sm text-muted lg:flex\"><a class=\"transition hover:text-foreground\" href=\"/\">Home</a><a class=\"transition hover:text-foreground\" href=\"/features\">Features</a><a class=\"transition hover:text-foreground\" href=\"/communities\">Communities</a><a class=\"transition hover:text-foreground\" href=\"/safety\">Safety</a><a class=\"transition hover:text-foreground\" href=\"/about\">About</a><a class=\"transition hover:text-foreground\" href=\"/faq\">FAQ</a><a class=\"transition hover:text-foreground\" href=\"/contact\">Contact</a></nav><div class=\"flex items-center gap-2\"><a href=\"http://localhost:3001/join\" class=\"btn-secondary hidden sm:inline-flex\">Get invite</a><a href=\"http://localhost:3001\" target=\"_blank\" rel=\"noopener noreferrer\" data-analytics-event=\"cta_start_hub_click\" data-analytics-cta=\"navbar_launch_app\" class=\"btn-primary\">Open app</a></div></div></header><main class=\"flex-1\"><div class=\"mx-auto flex w-full max-w-6xl flex-col gap-10 px-4 py-12 sm:px-6\"><section style=\"opacity:0;transform:translateY(24px)\"><div class=\"space-y-4\"><p class=\"inline-flex rounded-full border border-accent/30 bg-accent/10 px-3 py-1 text-xs font-semibold tracking-[0.14em] text-accent\">SAFETY &amp; PRIVACY</p><h1 class=\"text-4xl font-semibold leading-tight tracking-tight sm:text-5xl\">Safe spaces require intentional design.</h1><p class=\"max-w-3xl text-base leading-relaxed text-muted sm:text-lg\">Crowvo is built for communities that want trust — not for maximizing engagement, outrage, or data collection.</p></div></section><div class=\"grid gap-4 md:grid-cols-2\"><section style=\"opacity:0;transform:translateY(24px)\"><div class=\"glass-panel h-full rounded-2xl p-5\"><h2 class=\"text-lg font-semibold\">Privacy-first by design</h2><p class=\"mt-2 text-sm leading-relaxed text-muted\">Communities are private by default. You decide discoverability, invites, and who belongs — not an algorithm.</p></div></section><section style=\"opacity:0;transform:translateY(24px)\"><div class=\"glass-panel h-full rounded-2xl p-5\"><h2 class=\"text-lg font-semibold\">We do not sell your data</h2><p class=\"mt-2 text-sm leading-relaxed text-muted\">Crowvo is not an ad platform. We are not building profiles to sell to third parties.</p></div></section><section style=\"opacity:0;transform:translateY(24px)\"><div class=\"glass-panel h-full rounded-2xl p-5\"><h2 class=\"text-lg font-semibold\">You stay in control</h2><p class=\"mt-2 text-sm leading-relaxed text-muted\">Manage your account, sessions, and profile. Leave or delete your account when you choose.</p></div></section><section style=\"opacity:0;transform:translateY(24px)\"><div class=\"glass-panel h-full rounded-2xl p-5\"><h2 class=\"text-lg font-semibold\">Community moderation</h2><p class=\"mt-2 text-sm leading-relaxed text-muted\">Stewards and moderators your community appoints — with clear authority separate from identity tags.</p></div></section><section style=\"opacity:0;transform:translateY(24px)\"><div class=\"glass-panel h-full rounded-2xl p-5\"><h2 class=\"text-lg font-semibold\">Transparent policies</h2><p class=\"mt-2 text-sm leading-relaxed text-muted\">We explain what we collect, why we collect it, and how communities can govern their own spaces.</p></div></section><section style=\"opacity:0;transform:translateY(24px)\"><div class=\"glass-panel h-full rounded-2xl p-5\"><h2 class=\"text-lg font-semibold\">Invite-only demo</h2><p class=\"mt-2 text-sm leading-relaxed text-muted\">Public signups are closed during the demo. Access is granted through controlled invite codes.</p></div></section></div><div class=\"glass-panel space-y-4 rounded-2xl p-6\"><h2 class=\"text-xl font-semibold\">Authority vs. identity</h2><p class=\"text-sm leading-relaxed text-muted\">Profile tags like He/Him, Artist, or Student are for self-expression. They never grant moderation power. Authority layers — who can manage channels, events, invites, and governance — are configured separately by community leaders.</p><a class=\"text-sm text-accent hover:underline\" href=\"/faq\">Read common questions →</a></div></div><!--$--><!--/$--></main><footer class=\"border-t border-border bg-surface/80 backdrop-blur-xl\"><div class=\"mx-auto flex max-w-6xl flex-col gap-4 px-4 py-8 text-sm text-muted sm:px-6 md:flex-row md:items-center md:justify-between\"><p>© <!-- -->2026<!-- --> Crowvo — built for communities, not advertisers.</p><div class=\"flex flex-wrap gap-4 text-xs\"><a class=\"hover:text-foreground\" href=\"/safety\">Safety</a><a class=\"hover:text-foreground\" href=\"/faq\">FAQ</a><a class=\"hover:text-foreground\" href=\"/waitlist\">Request access</a></div></div></footer><script src=\"/_next/static/chunks/webpack-6bbc21fc53639a8a.js\" id=\"_R_\" async=\"\"></script><script>(self.__next_f=self.__next_f||[]).push([0])</script><script>self.__next_f.push([1,\"1:\\\"$Sreact.fragment\\\"\\n2:I[474,[\\\"229\\\",\\\"static/chunks/9da6db1e-a9775a91962987a2.js\\\",\\\"500\\\",\\\"static/chunks/500-c99b8dfd3de17c86.js\\\",\\\"177\\\",\\\"static/chunks/app/layout-0f5bf06c44d3fdf0.js\\\"],\\\"AnalyticsProvider\\\"]\\n3:I[8500,[\\\"500\\\",\\\"static/chunks/500-c99b8dfd3de17c86.js\\\",\\\"398\\\",\\\"static/chunks/398-1ebaea207cdb9881.js\\\",\\\"437\\\",\\\"static/chunks/app/safety/page-131c98d829b01e21.js\\\"],\\\"\\\"]\\n4:I[7121,[],\\\"\\\"]\\n5:I[4581,[],\\\"\\\"]\\na:I[7123,[],\\\"default\\\",1]\\n:HL[\\\"/_next/static/css/929cc579c236f361.css\\\",\\\"style\\\"]\\n\"])</script><script>self.__next_f.push([1,\"0:{\\\"P\\\":null,\\\"c\\\":[\\\"\\\",\\\"safety\\\"],\\\"q\\\":\\\"\\\",\\\"i\\\":false,\\\"f\\\":[[[