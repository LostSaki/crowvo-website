generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model WaitlistSignup {
  id            String           @id @default(cuid())
  email         String           @unique
  inviteCode    String?          @unique
  communityType String?
  status        String           @default("queued")
  backendCodeId String?
  referralCode  String?
  source        String?
  referredById  String?
  referredBy    WaitlistSignup?  @relation("ReferralTree", fields: [referredById], references: [id])
  referrals     WaitlistSignup[] @relation("ReferralTree")
  notifiedAt    DateTime?
  createdAt     DateTime         @default(now())
}

model InvestorInterest {
  id        String   @id @default(cuid())
  name      String
  email     String
  company   String
  checkSize String?
  message   String
  createdAt DateTime @default(now())
}

model AnalyticsEvent {
  id          String   @id @default(cuid())
  eventName   String
  path        String?
  referrer    String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  sessionId   String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([eventName, createdAt])
  @@index([sessionId, createdAt])
}

model RateLimitBucket {
  // Shared rate-limit counters, also modelled identically in crowvo-app/backend. Both
  // schemas must stay in step: a `prisma db push` from either package drops tables it
  // does not know about, which is how a shared table gets destroyed by a routine push.
  //
  // Used here because Cloudflare Workers give each isolate its own memory, so the previous
  // in-process Map limiter reset whenever a new isolate served the request — the limit
  // looked enforced and was not. Postgres is already a dependency of this site.
  key       String   @id
  count     Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
}
