{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/features/layout,_N_T_/features/page,_N_T_/features"},"segmentPaths":["/_tree","/_full","/features/__PAGE__","/features","/_index","/_head"]},"html":"<!DOCTYPE html><html lang=\"en\" class=\"__variable_246ccd __variable_4c40f6 h-full antialiased\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"stylesheet\" href=\"/_next/static/css/929cc579c236f361.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/webpack-6bbc21fc53639a8a.js\"/><script src=\"/_next/static/chunks/4bd1b696-215e5051988c3dde.js\" async=\"\"></script><script src=\"/_next/static/chunks/794-2e9f20eba326fbe9.js\" async=\"\"></script><script src=\"/_next/static/chunks/main-app-a00441ad7ebde43a.js\" async=\"\"></script><script src=\"/_next/static/chunks/9da6db1e-a9775a91962987a2.js\" async=\"\"></script><script src=\"/_next/static/chunks/500-c99b8dfd3de17c86.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/layout-0f5bf06c44d3fdf0.js\" async=\"\"></script><script src=\"/_next/static/chunks/398-1ebaea207cdb9881.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/features/page-131c98d829b01e21.js\" async=\"\"></script><title>Crowvo | Communities first. People first. Privacy first.</title><meta name=\"description\" content=\"Crowvo is built for communities — not advertisers. Talk, organize, and grow together without algorithms, data selling, or endless noise.\"/><link rel=\"icon\" href=\"/favicon.ico?603d046c9a6fdfbb\" type=\"image/x-icon\" sizes=\"16x16\"/><script src=\"/_next/static/chunks/polyfills-42372ed130431b0a.js\" noModule=\"\"></script></head><body class=\"crowvo-mesh flex min-h-full flex-col\"><div hidden=\"\"><!--$--><!--/$--></div><header class=\"sticky top-0 z-50 border-b border-border bg-background/85 backdrop-blur-xl\"><div class=\"mx-auto flex max-w-6xl items-center justify-between px-4 py-3 sm:px-6\"><a class=\"flex items-center gap-2.5 text-lg font-bold tracking-tight text-foreground\" href=\"/\"><div class=\"flex items-center justify-center rounded-2xl bg-accent font-bold text-white shadow-lg shadow-accent/30 h-10 w-10 text-base\">C</div>Crowvo</a><nav class=\"hidden gap-5 text-sm text-muted lg:flex\"><a class=\"transition hover:text-foreground\" href=\"/\">Home</a><a class=\"transition hover:text-foreground\" href=\"/features\">Features</a><a class=\"transition hover:text-foreground\" href=\"/communities\">Communities</a><a class=\"transition hover:text-foreground\" href=\"/safety\">Safety</a><a class=\"transition hover:text-foreground\" href=\"/about\">About</a><a class=\"transition hover:text-foreground\" href=\"/faq\">FAQ</a><a class=\"transition hover:text-foreground\" href=\"/contact\">Contact</a></nav><div class=\"flex items-center gap-2\"><a href=\"http://localhost:3001/join\" class=\"btn-secondary hidden sm:inline-flex\">Get invite</a><a href=\"http://localhost:3001\" target=\"_blank\" rel=\"noopener noreferrer\" data-analytics-event=\"cta_start_hub_click\" data-analytics-cta=\"navbar_launch_app\" class=\"btn-primary\">Open app</a></div></div></header><main class=\"flex-1\"><div class=\"mx-auto flex w-full max-w-6xl flex-col gap-10 px-4 py-12 sm:px-6\"><section style=\"opacity:0;transform:translateY(24px)\"><div class=\"space-y-4\"><p class=\"inline-flex rounded-full border border-accent/30 bg-accent/10 px-3 py-1 text-xs font-semibold tracking-[0.14em] text-accent\">WHAT YOU GET</p><h1 class=\"text-4xl font-semibold leading-tight tracking-tight sm:text-5xl\">Community tools — not creator tools.</h1><p class=\"max-w-3xl text-base leading-relaxed text-muted sm:text-lg\">Everything in Crowvo exists to help real groups talk, organize, and stay connected. Nothing is optimized for influencers, advertisers, or viral growth.</p><a href=\"http://localhost:3001/join\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"btn-primary mt-2 inline-flex\">Get an invite</a></div></section><div class=\"grid gap-4 md:grid-cols-2\"><section style=\"opacity:0;transform:translateY(24px)\"><div class=\"glass-panel h-full rounded-2xl p-5\"><h2 class=\"text-lg font-semibold\">Real communities</h2><p class=\"mt-2 text-sm leading-relaxed text-muted\">Private realms for friend groups, clubs, neighborhoods, and organizations — not public performance stages.</p></div></section><section style=\"opacity:0;transform:translateY(24px)\"><div class=\"glass-panel h-full rounded-2xl p-5\"><h2 class=\"text-lg font-semibold\">Private by default</h2><p class=\"mt-2 text-sm leading-relaxed text-muted\">You choose who can find you, who can join, and how open each space is.</p></div></section><section style=\"opacity:0;transform:translateY(24px)\"><div class=\"glass-panel h-full rounded-2xl p-5\"><h2 class=\"text-lg font-semibold\">Real-time chat</h2><p class=\"mt-2 text-sm leading-relaxed text-muted\">Talk naturally in channels without switching apps or losing context.</p></div></section><section style=\"opacity:0;transform:translateY(24px)\"><div class=\"glass-panel h-full rounded-2xl p-5\"><h2 class=\"text-lg font-semibold\">Community feeds</h2><p class=\"mt-2 text-sm leading-relaxed text-muted\">Share updates with the people who actually care — no algorithm deciding what you see.</p></div></section><section style=\"opacity:0;transform:translateY(24px)\"><div class=\"glass-panel h-full rounded-2xl p-5\"><h2 class=\"text-lg font-semibold\">Events</h2><p class=\"mt-2 text-sm leading-relaxed text-muted\">Bring people together. Plan meetups, game nights, volunteer days, and study sessions in one place.</p></div></section><section style=\"opacity:0;transform:translateY(24px)\"><div class=\"glass-panel h-full rounded-2xl p-5\"><h2 class=\"text-lg font-semibold\">Roles and groups</h2><p class=\"mt-2 text-sm leading-relaxed text-muted\">Clear authority layers so communities can govern themselves — without copying old server-admin models.</p></div></section><section style=\"opacity:0;transform:translateY(24px)\"><div class=\"glass-panel h-full rounded-2xl p-5\"><h2 class=\"text-lg font-semibold\">Secure accounts</h2><p class=\"mt-2 text-sm leading-relaxed text-muted\">Invite-only demo access, session management, and account controls built for real use.</p></div></section><section style=\"opacity:0;transform:translateY(24px)\"><div class=\"glass-panel h-full rounded-2xl p-5\"><h2 class=\"text-lg font-semibold\">Community governance</h2><p class=\"mt-2 text-sm leading-relaxed text-muted\">Founders, stewards, and moderators your community can rename to fit your culture.</p></div></section></div></div><!--$--><!--/$--></main><footer class=\"border-t border-border bg-surface/80 backdrop-blur-xl\"><div class=\"mx-auto flex max-w-6xl flex-col gap-4 px-4 py-8 text-sm text-muted sm:px-6 md:flex-row md:items-center md:justify-between\"><p>© <!-- -->2026<!-- --> Crowvo — built for communities, not advertisers.</p><div class=\"flex flex-wrap gap-4 text-xs\"><a class=\"hover:text-foreground\" href=\"/safety\">Safety</a><a class=\"hover:text-foreground\" href=\"/faq\">FAQ</a><a class=\"hover:text-foreground\" href=\"/waitlist\">Request access</a></div></div></footer><script src=\"/_next/static/chunks/webpack-6bbc21fc53639a8a.js\" id=\"_R_\" async=\"\"></script><script>(self.__next_f=self.__next_f||[]).push([0])</script><script>self.__next_f.push([1,\"1:\\\"$Sreact.fragment\\\"\\n2:I[474,[\\\"229\\\",\\\"static/chunks/9da6db1e-a9775a91962987a2.js\\\",\\\"500\\\",\\\"static/chunks/500-c99b8dfd3de17c86.js\\\",\\\"177\\\",\\\"static/chunks/app/layout-0f5bf06c44d3fdf0.js\\\"],\\\"AnalyticsProvider\\\"]\\n3:I[8500,[\\\"500\\\",\\\"static/chunks/500-c99b8dfd3de17c86.js\\\",\\\"398\\\",\\\"static/chunks/398-1ebaea207cdb9881.js\\\",\\\"944\\\",\\\"static/chunks/app/features/page-131c98d829b01e21.js\\\"],\\\"\\\"]\\n4:I[7121,[],\\\"\\\"]\\n5:I[4581,[],\\\